# --- Indexer runtime ---
PORT=4001

# --- MongoDB (optional in dev — falls back to in-memory store if missing) ---
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/logos
# MONGODB_DB=logos

# --- Arc testnet chain wiring ---
# Fill these in once the AgentRegistry / Marketplace / Reputation contracts are deployed.
# Without them the indexer runs in mock-emitter mode (synthesized events for the demo).
ARC_RPC_URL=
ARC_CHAIN_ID=
AGENT_REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
REPUTATION_ADDRESS=

# --- IPFS gateway (for trace fetches) ---
IPFS_GATEWAY=https://w3s.link/ipfs

# --- CORS allowlist for the dashboard (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000
