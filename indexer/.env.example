# --- Indexer runtime ---
PORT=4001

# --- MongoDB (optional in dev — falls back to in-memory store if missing) ---
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/logos
# MONGODB_DB=logos

# --- Arc testnet chain wiring ---
# Fill these in once the AgentRegistry / Marketplace / Reputation contracts are deployed.
# Without them the indexer runs in mock-emitter mode (synthesized events for the demo).
ARC_RPC_URL=
ARC_CHAIN_ID=
AGENT_REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
REPUTATION_ADDRESS=
# Block the Marketplace was deployed at. Set this so the poller backfills from
# the contract's first block on boot — the counters (volume / queries / traces /
# wallets) then rebuild from full chain history and survive a restart instead of
# resetting to a short trailing window. Unset = trailing-window fallback only.
MARKETPLACE_DEPLOY_BLOCK=

# --- IPFS gateway (for trace fetches) ---
IPFS_GATEWAY=https://w3s.link/ipfs

# --- CORS allowlist for the dashboard (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000

# Where the specialist fleet is reachable (for /api/offers discovery endpoints)
FLEET_PUBLIC_URL=http://localhost:8080

# Optional shared secret gating POST /api/ingest/trace (traders report the real
# IPFS CID here so the live feed links to a resolvable trace). Leave blank to
# keep the endpoint open on a single-tenant demo box.
INGEST_SECRET=
