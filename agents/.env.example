# --- Shared ---
ARC_RPC_URL=
ARC_CHAIN_ID=
MARKETPLACE_ADDRESS=
AGENT_REGISTRY_ADDRESS=

# --- Settlement (FR-3) ---
# simulated (default): opaque keccak payment-auth anchored on-chain, no USDC moves.
# real: trader signs EIP-3009 ReceiveWithAuthorization; specialist submits it to
# move real USDC before serving. Flip to "real" to demo; "simulated" to revert.
SETTLEMENT_MODE=simulated
USDC_ADDRESS=0x3600000000000000000000000000000000000000
SETTLEMENT_VALIDITY_SECS=300

# --- Specialist (per-process) ---
SPECIALIST_PRIVATE_KEY=
SPECIALIST_PAYOUT_ADDRESS=

# --- IPFS pinning (optional; falls back to dev:<sha256> if both missing) ---
WEB3_STORAGE_TOKEN=
PINATA_JWT=

# --- Real-data specialists ---
# onchain_dex_data + risk_checker use the Dexscreener public API (no key) and
# polymarket_structurer uses the Polymarket Gamma API (no key). Only
# whale_tracker_eth needs a key — a free Etherscan key (https://etherscan.io/myapikey).
# Without it, whale_tracker_eth falls back to its deterministic stub.
ETHERSCAN_API_KEY=

# --- Atlas trader ---
ATLAS_PRIVATE_KEY=
MANDARIN_MACRO_URL=http://localhost:7401
TWITTER_SENTIMENT_URL=http://localhost:7402
POLYMARKET_STRUCTURER_URL=http://localhost:7403
WHALE_TRACKER_ETH_URL=http://localhost:7404
RISK_CHECKER_URL=http://localhost:7405
NEWS_SUMMARIZER_URL=http://localhost:7406
KELLY_SIZER_URL=http://localhost:7407
ONCHAIN_DEX_DATA_URL=http://localhost:7408

# Indexer base URL for FR-2 offer discovery (optional — traders can also use an explicit directory).
# Also where traders POST the real trace CID (so the live feed links to a resolvable trace).
LOGOS_DISCOVERY_URL=http://localhost:4001
# Must match the indexer's INGEST_SECRET if that endpoint is gated (optional).
LOGOS_INGEST_SECRET=

# Health monitor (opt-in, FR-10) — run via: ./.venv/bin/python monitor/main.py
HEALTH_THRESHOLD=3
HEALTH_INTERVAL=30
FLEET_BASE=http://localhost:8080
